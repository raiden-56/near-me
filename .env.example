# Copy to .env.local and adjust. Every value is optional: without a .env file NearMe runs on
# keyless public OpenStreetMap services and keeps community data on the device ("local mode").
# Only VITE_* values reach the browser. Never put a Supabase service-role key in this file.

# ── Map rendering ────────────────────────────────────────────────────────────────────────────
# Any MapLibre style JSON URL. Use {key} where the provider expects your API key.
#   MapTiler:  https://api.maptiler.com/maps/streets-v2/style.json?key={key}
#   Stadia:    https://tiles.stadiamaps.com/styles/alidade_smooth.json?api_key={key}
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
VITE_MAP_API_KEY=
# NearMe recolours the base style to the warm brand palette. Set to false to use the style as-is.
VITE_MAP_BRAND_THEME=true

# ── Place data (OpenStreetMap) ───────────────────────────────────────────────────────────────
# TileJSON of an OpenMapTiles-schema vector tileset; its "poi" layer is the fast baseline source.
VITE_POI_TILEJSON_URL=https://tiles.openfreemap.org/planet
# Comma-separated Overpass API endpoints, tried in order with hedging. Host your own for production.
VITE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://overpass.private.coffee/api/interpreter

# ── Geocoding, routing, photos ───────────────────────────────────────────────────────────────
VITE_PHOTON_URL=https://photon.komoot.io
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
# {profile} becomes car, bike or foot.
VITE_OSRM_URL=https://routing.openstreetmap.de/routed-{profile}
VITE_COMMONS_API_URL=https://commons.wikimedia.org/w/api.php

# ── Starting location (used until the user shares or picks one) ──────────────────────────────
VITE_DEFAULT_LAT=12.9142
VITE_DEFAULT_LON=77.6095
VITE_DEFAULT_AREA=BTM Layout
VITE_DEFAULT_CITY=Bengaluru
VITE_DEFAULT_COUNTRY_CODE=in

# ── Backend (Supabase) ───────────────────────────────────────────────────────────────────────
# Leave empty for local mode. Fill both to enable real accounts (email, Google, phone OTP).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Web push ─────────────────────────────────────────────────────────────────────────────────
# Public VAPID key. The private key stays on the server that sends notifications.
VITE_VAPID_PUBLIC_KEY=
